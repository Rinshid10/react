# Appwrite Cloud connection.
#
# Copy this file to `.env.local` and fill in the two values from your Appwrite
# console (Project -> Settings -> Overview). Both are PUBLIC by design: the
# browser sends the project id on every request, so they are visible in devtools
# regardless. Nothing secret belongs in a VITE_ variable.
#
# NEVER add an Appwrite API key here. A `standard_...` key grants server-side
# privileges and any VITE_-prefixed variable is inlined into the public bundle.
#
# Leave these unset and the site still builds and renders its built-in content,
# with no network requests and no Appwrite code downloaded at all.

VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=portfolio

# ---------------------------------------------------------------------------
# Schema setup only — NOT used by the site, and never sent to the browser.
#
# Create at: Appwrite console -> Overview -> API Keys -> Create API key
# Scopes needed: tables.read, tables.write
#
# Note the missing VITE_ prefix. That is deliberate and load-bearing: Vite
# inlines every VITE_ variable into the public bundle, so a key named
# VITE_APPWRITE_API_KEY would hand full database access to anyone who opens
# devtools. Only `npm run appwrite:setup` reads this, on your machine.
#
# Delete the key from the Appwrite console once the schema is created.
# ---------------------------------------------------------------------------
APPWRITE_API_KEY=
